# ============================================================
# DevSecOps Platform — Environment Variables
# Copy this file to .env and fill in real values before running
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=devsecops
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=devsecops
DATABASE_URL=postgresql://devsecops:changeme_strong_password@postgres:5432/devsecops

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- API Server ---
NODE_ENV=development
PORT=3000
# Generate with: openssl rand -base64 48
SESSION_SECRET=changeme_session_secret_min_32_chars

# --- GitHub OAuth App ---
# Create at: https://github.com/settings/developers → OAuth Apps → New
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# --- Internal Service URLs ---
SCANNER_URL=http://scanner:8000
API_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- Encryption (for storing integration credentials) ---
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=changeme_64_hex_chars_equals_32_bytes_00000000000000000000000000000000

# --- OWASP ZAP (DAST sidecar) ---
# Generate with: openssl rand -hex 16
ZAP_API_KEY=changeme_zap_api_key
ZAP_BASE_URL=http://zap:8080

# --- Scanner workspace ---
SCAN_WORKSPACE_DIR=/tmp/scan_workspace

# --- Optional: Nuclei templates (auto-downloaded if not set) ---
# NUCLEI_TEMPLATES_DIR=/opt/nuclei-templates
