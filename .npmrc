# Use hoisted node_modules layout (like npm/yarn) instead of pnpm's
# default isolated symlink layout.
#
# Why: tools like Prisma resolve their own binaries via direct file paths
# (e.g. node_modules/prisma/build/index.js). With pnpm's isolated linker
# those paths are symlinks into the virtual store, which breaks inside
# Docker containers. Hoisted mode writes real files to node_modules so
# all tools find what they expect.
node-linker=hoisted
shamefully-hoist=true
