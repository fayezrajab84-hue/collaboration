DeviceProcessEvents
// Filter to only events containing keywords related to known defense evasion TTPs
| where ProcessCommandLine has_any(
    "-ExclusionPath",
    "Set-MpPreference",
    "advfirewall",
    "-ExclusionExtension",
    "-EnableControlledFolderAccess",
    "windefend",
    "onstart",
    "bcdedit",
    "Startup"
)
// Aggregate all matching command lines per device per 6-hour window
| summarize CommandLine = make_set(ProcessCommandLine, 10000) by DeviceId, DeviceName, bin(TimeGenerated, 6h)
// --- TTP Detection Flags ---
// T1547.001 - Startup Folder Exclusion Path
| extend StartUpExclusionPath = iff(CommandLine has_all("-ExclusionPath", "Startup"), 1, 0)
// T1562.001 - Defender Preference Tampering via Set-MpPreference
| extend DefenderTamp = iff(
    CommandLine has "Set-MpPreference"
    and CommandLine has_any(
        "-SevereThreatDefaultAction 6",   // FIX: added missing comma
        "-HighThreatDefaultAction 6",
        "-ModerateThreatDefaultAction 6",
        "-LowThreatDefaultAction 6",      // FIX: added missing comma
        "-ScanScheduleDay 8"
    ), 1, 0)
// T1562.004 - Firewall Tampering via netsh
| extend NetshFirewallTampering = iff(CommandLine has_all("netsh", "advfirewall", "allprofiles state off"), 1, 0)
// T1562.001 - Exclusion of .bat files from Defender scanning
| extend BatExclusion = iff(CommandLine has_all("-ExclusionExtension", ".bat"), 1, 0)
// T1562.001 - Exclusion of .exe files from Defender scanning
| extend ExeExclusion = iff(CommandLine has_all("-ExclusionExtension", ".exe"), 1, 0)
// T1562.001 - Disabling Controlled Folder Access
| extend DisableControlledFolderAccess = iff(CommandLine has_all("-EnableControlledFolderAccess", "Disabled"), 1, 0)
// T1562.001 - Deleting the Windows Defender service
| extend ScDeleteDefend = iff(CommandLine has_all("sc", "delete", "windefend"), 1, 0)
// T1542.003 - Boot/Recovery Tampering via bcdedit
| extend BootTampering = iff(
    CommandLine has_all("bcdedit", "default")
    and CommandLine has_any("recoveryenabled No", "bootstatuspolicy ignoreallfailures"), 1, 0)
// T1053.005 - Scheduled Task created to run at startup as SYSTEM
| extend SchTasks = iff(CommandLine has_all("/sc", "onstart", "system", "/create", "/delay"), 1, 0)
// Deduplicate rows across all TTP flag columns and device/time groupings
| summarize by
    StartUpExclusionPath,
    DefenderTamp,
    NetshFirewallTampering,
    BatExclusion,
    ExeExclusion,
    DisableControlledFolderAccess,
    ScDeleteDefend,
    BootTampering,
    SchTasks,
    DeviceId,
    DeviceName,
    TimeGenerated
// Sum all TTP flags into a single evidence score
| extend EvidenceCount = (
    StartUpExclusionPath
    + DefenderTamp
    + NetshFirewallTampering
    + BatExclusion
    + ExeExclusion
    + DisableControlledFolderAccess
    + ScDeleteDefend
    + BootTampering
    + SchTasks
)
// Only surface devices with high evidence of defense evasion activity
| where EvidenceCount > 4
// Parse hostname and DNS domain from the Dvc FQDN field
| extend HostName  = iff(DeviceName has '.', substring(DeviceName, 0, indexof(DeviceName, '.')), DeviceName)
| extend DnsDomain = iff(DeviceName has '.', substring(DeviceName, indexof(DeviceName, '.') + 1), "")
