// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────

enum OrgType {
  PERSONAL
  TEAM
}

enum Role {
  OWNER
  ADMIN
  SECURITY
  DEVELOPER
  VIEWER
  MEMBER     // legacy — treated as DEVELOPER by RBAC layer
}

enum ScanType {
  SAST
  SCA
  SECRET
  IAC
  CONTAINER
  DAST
  PENTEST
  PENTEST_FULL
  // Phase 28 Slice A — runtime detection. Wazuh agents on hosts/containers
  // emit syscall / FIM / command-exec / network / vulnerability alerts; the
  // ingestion service polls Wazuh and creates RUNTIME findings. Continuous,
  // not point-in-time — `firstSeen` and `lastSeen` track the rolling window.
  RUNTIME
}

// Phase 28 Slice A — health of a Wazuh agent attached to this org.
//   HEALTHY  — last heartbeat within 2 minutes
//   STALE    — heartbeat 2-10 minutes ago (warning band)
//   OFFLINE  — heartbeat older than 10 minutes (assume dead)
//   UNKNOWN  — never reported, just enrolled
enum AgentStatus {
  HEALTHY
  STALE
  OFFLINE
  UNKNOWN
}

// Phase 27.5 — Application boundary for correlation. Operators group
// related Repository / Container / Domain rows into one Application; the
// correlation engine then scopes its sweep to a single Application's
// assets so unrelated apps that happen to share base-image CVEs don't
// merge into one mega-chain (the Phase 27 bug we surfaced).
enum ApplicationEnv {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum Criticality {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum RecordingStatus {
  ACTIVE      // user is currently browsing through the proxy
  STOPPED     // user clicked stop or session timed out
  SCANNING    // active scan kicked off; recording is implicitly stopped
  COMPLETED   // active scan finished
  FAILED      // active scan errored out
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  FALSE_POSITIVE
  FIXED
  IGNORED          // AI-auto-dismissed: LIKELY_FP + HIGH confidence in sweep
}

enum Confidence {
  CONFIRMED
  LIKELY
  POSSIBLE
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum TargetType {
  REPOSITORY
  CONTAINER
  DOMAIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IntegrationType {
  JIRA
  SLACK
  MICROSOFT_TEAMS
}

// ── AI provider abstraction ──────────────────────────────────────────────────
// Lets each org plug in any of these as their AI backend, and optionally route
// individual services (FP triage / fix suggestion / scan summary / …) to
// different providers. Keys are AES-256-GCM encrypted via encryptionService,
// same pattern as Integration.encryptedData.
enum AIProviderType {
  ANTHROPIC
  OPENAI
  GEMINI
  OLLAMA
}

// One row per AI service that the platform calls. Used as the discriminator
// for per-service routing overrides. Add new entries here when introducing a
// new AI-backed feature.
enum AIServiceName {
  ANALYSE_FINDING       // aiService.analyseFinding — drawer deep analysis
  FP_TRIAGE             // falsePositiveService — verdict + confidence
  FIX_SUGGESTION        // fixSuggestionService — unified diff
  SCAN_SUMMARY          // scanSummaryService — post-scan paragraph
  RISK_SCORE            // riskScoringService — repo/container/domain score
  CHAT                  // chatService — interactive Q&A
  GROUP_INSIGHT         // findingGroupService — cluster commentary
  ATTACK_PATH_SUMMARY   // attackPathSummaryService — narrative for one chain
}

enum ReportTrigger {
  ON_SCAN_COMPLETE
  MANUAL
}

enum PentestDepth {
  QUICK       // Nuclei (high+critical only) — skip Nikto/testssl/exploit (~5-10 min)
  STANDARD    // recon + discovery + vuln scan (no exploitation)
  AGGRESSIVE  // + exploitation phase (SQLMap, XSStrike) — requires authorization
}

enum AuthType {
  FORM    // submit username/password form, maintain session cookie
  HEADER  // inject a static HTTP header (API key, Bearer token)
  COOKIE  // inject a pre-obtained cookie string directly
  OAUTH2  // exchange client credentials / ROPC for a Bearer token
}

// ── Scan trigger + PR-check integration ──────────────────────────────────────
// Separates how a scan was initiated from what it scanned. PR scans fan out to
// PrCheckRun which tracks the GitHub Check Run row so we can update it from the
// worker as the scan progresses / completes.
enum ScanTrigger {
  MANUAL          // user clicked "Scan" in the UI or hit POST /scan
  PUSH            // default-branch push webhook
  PULL_REQUEST    // PR open / sync / reopen
  SCHEDULED       // cron
}

// Policy rules: each row is one gate that contributes to the PR check decision.
// `config` is rule-type-specific — validated in code, not in the DB.
// Phase 14 — package-level reachability classification for SCA findings.
// True call-graph reachability is months of work per language; this is the
// pragmatic v1 — "is this dep actually imported anywhere in the source?"
// Cuts ~50% of typical SCA noise (transitive deps no one references).
enum Reachability {
  REACHABLE        // package found in at least one import/require statement
  NOT_REACHABLE    // package present in lockfile but not imported anywhere
  UNKNOWN          // can't determine — language unsupported, source unavailable, or finding pre-dates Phase 14
  NOT_APPLICABLE   // not an SCA finding (DAST/SAST/SECRET/IAC etc — reachability concept doesn't apply)
}

enum PolicyRuleType {
  SEVERITY_THRESHOLD    // config: { severity: Severity }       → fail if any OPEN finding ≥ severity
  BLOCK_ON_NEW_ONLY     // config: {}                           → qualifier: scope thresholds to PR-new findings
  SLA_DAYS              // config: { severity, days }           → fail if OPEN finding at severity older than N days
  IGNORE_DEV_DEPS       // config: {}                           → strip SCA findings in devDependencies
  SCAN_TYPE_REQUIRED    // config: { scanTypes: ScanType[] }    → fail if any required type didn't run successfully
}

// ── Models ────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  githubId     String   @unique
  username     String
  email        String?
  avatarUrl    String?
  accessToken  String   // AES-256-GCM encrypted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizations OrganizationMember[]
  tickets       Ticket[]
  recordings    RecordingSession[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  type      OrgType  @default(PERSONAL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         OrganizationMember[]
  repositories    Repository[]
  containers      Container[]
  domains         Domain[]
  applications    Application[]
  integrations    Integration[]
  findings        Finding[]
  tickets         Ticket[]
  scanJobs        ScanJob[]
  reports         Report[]
  aiProviders     AIProvider[]
  aiServiceRoutings AIServiceRouting[]
  aiCallLogs      AICallLog[]
  recordings      RecordingSession[]
  policies        Policy[]
  invitations     Invitation[]
  ssoConfig       SsoConfig?
  sboms           Sbom[]
}

// ── Phase 27.5.x — AI summary cache for a correlated chain ────────────────
// One row per `Finding.correlationGroupId` that we've summarised. Cached
// because the AI call is slow (~5-15s) and costs money; the operator
// triggers regeneration via the "Refresh summary" button when the chain
// composition has shifted.
//
// Stored as plain text (markdown allowed) so the UI can render it without
// further parsing. tldr is the 1-line headline shown in the chain card
// header; narrative is the full 2-3 paragraph explanation.
model AttackPathSummary {
  id                 String   @id @default(cuid())
  orgId              String
  // Same shape as Finding.correlationGroupId — chains are coalesced
  // groups; the id is anchored on the chain's union-find root finding.
  // Not a FK — chains can re-key when their root finding is deleted, and
  // we don't want to lose the cached summary on every minor churn.
  correlationGroupId String   @unique
  // Phase 27.5.x — short headline (~6 words) for the chain card title.
  // Generated alongside tldr+narrative so it costs no extra AI call.
  title              String?
  tldr               String
  narrative          String   @db.Text
  // Track which provider + model produced this so the UI can surface it
  // ("Generated with Claude Sonnet 4.5") and so a future "regenerate
  // because the model has changed" check is possible.
  providerType       AIProviderType
  model              String
  // The chain's content fingerprint at generation time — when the chain
  // changes (members added/removed via correlation refresh), the
  // summary becomes stale and the UI nudges the operator to regenerate.
  contentHash        String
  generatedAt        DateTime @default(now())

  @@index([orgId, generatedAt(sort: Desc)])
}

// ── Phase 27.5 — Application boundary ─────────────────────────────────────
// First-class entity that owns a Repository / Container / Domain set. The
// Phase 27 correlation engine scopes its sweep PER application, so unrelated
// apps that happen to share a base-image CVE no longer collapse into one
// mega-chain. Manual creation (no auto-magic); existing assets stay
// `applicationId = null` until an operator assigns them, and unassigned
// findings simply don't get correlated.
model Application {
  id          String         @id @default(cuid())
  orgId       String
  name        String
  // url-safe identifier; unique per org; auto-derived from name on create
  // unless operator overrides
  slug        String
  description String?
  environment ApplicationEnv @default(PRODUCTION)
  criticality Criticality    @default(MEDIUM)
  // Optional free-text — team / contact email / Slack channel
  owner       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repositories Repository[]
  containers   Container[]
  domains      Domain[]

  @@unique([orgId, slug])
  @@index([orgId, environment])
}

// SBOM format the document is encoded in. Both produce JSON.
//   CYCLONEDX → CycloneDX 1.6 (most common; what most tooling expects)
//   SPDX      → SPDX 2.3 (ISO/IEC 5962; required by some procurement reviewers)
enum SbomFormat {
  CYCLONEDX
  SPDX
}

// Instance-wide ECDSA P-256 keypair used to sign every persisted SBOM.
// Singleton — only ever one row (enforced by application code, not schema,
// because Prisma can't express "exactly one row" cleanly).
//
// Why ECDSA P-256 SHA256: matches the cosign default so signatures verify
// with `cosign verify-blob --key <pub> --signature <sig>`. Operators who
// already have cosign tooling don't need to learn a second crypto path.
//
// Private key is AES-256-GCM encrypted via encryptionService at rest. The
// public key is plaintext (it's public). Algorithm is denormalised so a
// future migration to RSA / Ed25519 can land alongside the new key without
// breaking historical signatures (Sbom.signatureKeyId points back here).
//
// Rotation: delete this row + ENCRYPTION_KEY rotation runbook covers the
// re-encryption side. New row gets generated lazily on next sign attempt.
// Old signatures stay valid as long as the matching public key is preserved
// elsewhere (operator export — not yet implemented; Phase 15 follow-up).
model SbomSigningKey {
  id                  String   @id @default(cuid())
  algorithm           String   @default("ECDSA_P256_SHA256")
  publicKeyPem        String
  encryptedPrivateKey String   // AES-256-GCM via encryptionService
  createdAt           DateTime @default(now())

  signedSboms Sbom[]
}

// Per-scan persisted SBOM. Auto-generated by the worker after each SCA scan
// (CycloneDX only; SPDX is generated on-demand via the download endpoint
// fallback path because dual generation doubles per-scan Trivy time).
//
// Multiple rows per (repo, format) — one per scan — for historical lookups
// ("what did the BOM look like at scan T?") and component-delta tracking.
// The download endpoint queries `latest` via the (repoId, format, generatedAt)
// index; older rows accumulate until a future retention policy prunes them.
//
// The `document` JSONB column holds the full SBOM (typically 1KB-1MB).
// componentCount is denormalised from the document for cheap counts on the
// repo list without parsing every blob.
model Sbom {
  id             String     @id @default(cuid())
  orgId          String
  repositoryId   String?    // null for non-repo SBOMs (containers — Slice D)
  containerId    String?
  scanJobId      String?    // links the SBOM to the scan that produced it
  format         SbomFormat
  document       Json
  componentCount Int        @default(0)
  // Fingerprint of the document body (sha256 of canonical JSON). Lets the
  // worker dedupe — if the SBOM is byte-identical to the previous one for
  // this (repo, format) we skip the insert and just update generatedAt.
  contentHash    String
  // Cosign-compatible base64 signature (ECDSA P-256 SHA256 of the canonical
  // JSON document). Null when signing is mid-rollout or has failed.
  // Verifiable with `cosign verify-blob --key <pub> --signature <sig>`.
  signature        String?
  signatureKeyId   String?  // FK into SbomSigningKey — survives rotation
  signedAt         DateTime?
  generatedAt    DateTime   @default(now())

  org         Organization    @relation(fields: [orgId],          references: [id], onDelete: Cascade)
  repository  Repository?     @relation(fields: [repositoryId],   references: [id], onDelete: Cascade)
  container   Container?      @relation(fields: [containerId],    references: [id], onDelete: Cascade)
  signingKey  SbomSigningKey? @relation(fields: [signatureKeyId], references: [id], onDelete: SetNull)

  @@index([repositoryId, format, generatedAt(sort: Desc)])
  @@index([containerId, format, generatedAt(sort: Desc)])
  @@index([orgId, generatedAt(sort: Desc)])
}

// Per-org OIDC SSO configuration. One row per org max (1:1 with Organization).
//
// Why split out instead of a JSON column on Organization:
//   - issuerUrl + clientId + allowedEmailDomains need to be queryable to
//     route incoming logins to the right org BEFORE the OAuth round-trip
//     starts (e.g. user types alice@acme.com → look up which org owns
//     "acme.com" in allowedEmailDomains)
//   - clientSecret needs to be encrypted alongside, but as JSON so we can
//     extend later (refresh tokens, JWKS overrides) without a migration
//
// Phase 22 PR 3 Slice A: this model + the config UI.
// Phase 22 PR 3 Slice B: actual passport-openidconnect strategy that reads it.
model SsoConfig {
  id                  String   @id @default(cuid())
  orgId               String   @unique
  // OIDC discovery endpoint: <issuerUrl>/.well-known/openid-configuration
  // resolves the rest (token/userinfo/jwks). E.g. for Okta:
  //   https://<tenant>.okta.com/oauth2/default
  issuerUrl           String
  clientId            String
  // Email domains that map to this org. Lowercase, no @. E.g. ["acme.com"].
  // The login flow uses this to route an incoming user to the right org.
  allowedEmailDomains String[]
  // AES-256-GCM encrypted JSON: { clientSecret: string, ... }
  // JSON-shape so we can add jwks/refresh-token storage without migrations.
  encryptedSecrets    Json
  // Group claim name → BreachLens role. E.g. { "devsecops-admins": "ADMIN" }.
  // The OIDC strategy reads this on each login; first match wins, defaults
  // to defaultRole if no claim matches.
  groupRoleMapping    Json     @default("{}")
  defaultRole         Role     @default(DEVELOPER)
  // Operator switch — disable SSO without losing config (e.g. during an
  // IdP outage or migration). When false, `/auth/sso/*` returns 503 for
  // this org and only GitHub OAuth works.
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// Pending org invitations matched by GitHub username on next OAuth login.
// Username-based (not email) because the platform uses GitHub OAuth as
// the only auth method today. Switch to email-based when SSO (Phase 22 PR 3)
// lands.
//
// Lifecycle:
//   • created  → row inserted by ADMIN+ via POST /api/members/invitations
//   • accepted → passport callback finds pending row matching profile.username
//                (case-insensitive), creates OrganizationMember row, sets
//                acceptedAt + acceptedUserId on the invitation
//   • revoked  → row deleted by ADMIN+ via DELETE; users can't see invitations
//                that no longer exist
//
// invitedById and acceptedUserId are stored as plain User.id strings without
// Prisma relations to keep the User model clean (already has 3 back-refs).
// Lookups go through prisma.user.findMany separately when enriching for UI.
model Invitation {
  id              String    @id @default(cuid())
  orgId           String
  githubUsername  String    // stored lowercase for case-insensitive match
  role            Role      @default(DEVELOPER)
  invitedById     String
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedUserId  String?
  createdAt       DateTime  @default(now())

  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, githubUsername])
  @@index([githubUsername])
  @@index([orgId, acceptedAt])
}

model OrganizationMember {
  userId String
  orgId  String
  role   Role     @default(DEVELOPER)

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([userId, orgId])
}

model Repository {
  id            String    @id @default(cuid())
  orgId         String
  githubId      Int       @unique
  fullName      String
  url           String
  defaultBranch String    @default("main")
  isPrivate     Boolean   @default(false)
  language      String?
  webhookId     Int?
  webhookSecret  String?   // AES-256-GCM encrypted
  // Set when the GitHub App is installed on the owner + has this repo in scope.
  // Required for posting PR Check Runs + inline review comments. Nullable so
  // platform keeps working for repos added via the legacy PAT webhook path.
  githubAppInstallationId Int?
  // Optional per-repo policy override. When null, policyService falls back to
  // the org's Policy with isDefault=true.
  policyId                String?
  // Phase 27 Slice A — operator-declared asset relations. Stores the container
  // image refs this repo builds (e.g. ["myorg/api:latest"]). Powers the
  // attack-path correlation engine — "vuln in repo X is in container Y deployed
  // at domain Z." v1 is operator-declared via the AssetLinksPanel UI; CI-based
  // inference (Dockerfile + image-name parsing) is a Phase 27.x follow-up.
  buildsContainerImages   String[]  @default([])
  // Phase 27.5 — Application boundary. Null until operator assigns; when
  // null this asset's findings don't participate in correlation chains.
  applicationId           String?
  lastScannedAt  DateTime?
  aiRiskScore    Int?      // 0-100
  aiRiskReason   String?
  aiRiskScoredAt DateTime?
  addedAt        DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  policy      Policy?      @relation(fields: [policyId], references: [id], onDelete: SetNull)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  scans       ScanJob[]
  findings    Finding[]
  prCheckRuns PrCheckRun[]
  sboms       Sbom[]

  @@index([orgId, githubAppInstallationId])
  @@index([applicationId])
}

model Container {
  id             String    @id @default(cuid())
  orgId          String
  imageRef       String
  registry       String?
  // Phase 27 Slice A — operator-declared asset relations. Powers the attack-
  // path graph: a finding on this container can be correlated upstream to
  // the source repo that builds it, and downstream to the domains it serves.
  // Stored as plain strings (not FK arrays) because Prisma can't model
  // many-to-many across the same table without a join table; the resolver
  // in correlationService walks these arrays at query time.
  sourceRepositoryId   String?
  deployedAtDomainIds  String[]  @default([])
  // Phase 27.5 — Application boundary. See Repository.applicationId comment.
  applicationId        String?
  lastScannedAt  DateTime?
  aiRiskScore    Int?
  aiRiskReason   String?
  aiRiskScoredAt DateTime?
  addedAt        DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  scans       ScanJob[]
  findings    Finding[]
  sboms       Sbom[]

  @@index([applicationId])
}

model Domain {
  id              String       @id @default(cuid())
  orgId           String
  domain          String
  lastScannedAt   DateTime?
  aiRiskScore     Int?
  aiRiskReason    String?
  aiRiskScoredAt  DateTime?
  addedAt         DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  // Pentest authorization
  authorized      Boolean      @default(false)
  authorizedAt    DateTime?
  authorizedById  String?
  pentestDepth    PentestDepth @default(STANDARD)
  excludePaths    String[]
  // Phase 27 Slice A — operator-declared asset relations. The container IDs
  // that answer requests at this hostname (load-balancer fronts → multiple
  // containers; single-container deploys → array of one). Powers attack-path
  // chains: DAST/PENTEST finding on this domain can be correlated to the
  // running container's CVEs and onward to the source repo.
  servesContainerIds  String[]  @default([])
  // Phase 27.5 — Application boundary. See Repository.applicationId comment.
  applicationId       String?

  org         Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  application Application?         @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  scans       ScanJob[]
  findings    Finding[]
  subdomains  SubdomainDiscovery[]
  authConfig  DomainAuthConfig?
  apiSpec     DomainApiSpec?
  recordings  RecordingSession[]

  @@index([applicationId])
}

// ── Interactive DAST recording session ────────────────────────────────────────
// One row per "user opens browser → proxies through ZAP → scans recorded URLs"
// flow. ACTIVE rows hold a ZAP context open; the single-session lock is enforced
// by the unique partial index below (only one ACTIVE row per org at a time).
model RecordingSession {
  id              String          @id @default(cuid())
  orgId           String
  domainId        String
  startedById     String                                  // user who clicked "Start Recording"
  zapContextId    String                                  // ZAP-assigned numeric context id
  zapContextName  String                                  // human-readable name we picked
  status          RecordingStatus @default(ACTIVE)
  urlCount        Int             @default(0)             // last polled count of recorded URLs
  alertCount      Int             @default(0)             // last polled passive-scan alert count
  lastActivityAt  DateTime        @default(now())         // bumped each time we see new URLs (for idle auto-stop)
  scanJobId       String?                                 // populated when user kicks off the active scan (interactive DAST)
  promotedScanJobId String?                               // populated when user "Promotes to Full Pentest" (PENTEST_FULL, independent of scanJobId)
  startedAt       DateTime        @default(now())
  endedAt         DateTime?
  errorMessage    String?

  domain          Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  startedBy       User     @relation(fields: [startedById], references: [id])
  scanJob         ScanJob? @relation("RecordingInteractiveScan", fields: [scanJobId],         references: [id])
  promotedScanJob ScanJob? @relation("RecordingPromotedScan",    fields: [promotedScanJobId], references: [id])

  @@index([orgId, status])
  @@index([domainId, startedAt])
}

// ── Scan authentication config ────────────────────────────────────────────────
// Stores encrypted credentials used by ZAP and Nuclei for authenticated scans.
model DomainAuthConfig {
  id               String   @id @default(cuid())
  domainId         String   @unique
  authType         AuthType @default(FORM)
  // FORM auth fields
  loginUrl         String?                   // absolute or path: /login.php
  usernameField    String   @default("username")
  passwordField    String   @default("password")
  loggedInPattern  String   @default("Logout")   // regex ZAP checks to confirm auth
  loggedOutPattern String   @default("login")    // redirect URL fragment = session expired
  // HEADER / COOKIE auth fields
  headerName       String?                   // e.g. "Authorization", "Cookie"
  // OAuth2 fields (authType = OAUTH2)
  oauth2TokenUrl   String?                   // e.g. https://auth.example.com/oauth/token
  oauth2ClientId   String?
  oauth2Scope      String?                   // space-separated, e.g. "openid profile api:read"
  oauth2GrantType  String   @default("client_credentials")  // client_credentials | password
  // CSRF token tracking for SPAs that protect mutating endpoints with a
  // header (X-CSRF-Token / X-XSRF-TOKEN). Independent of authType — works
  // standalone or layered on top of FORM/HEADER/OAUTH2. Set one of:
  //   csrfMetaSelector — CSS selector for an HTML element whose `content`
  //                       attr holds the token (Rails / Laravel / .NET)
  //   csrfCookieName   — cookie name for double-submit pattern (Django,
  //                       Express csurf, Angular)
  // ``csrfHeaderName`` defaults to X-CSRF-Token but per-app overrides are
  // common.
  csrfMetaSelector String?
  csrfCookieName   String?
  csrfHeaderName   String?  // null = use crawler default ("X-CSRF-Token")
  // Encrypted payload — AES-256-GCM JSON blob:
  //   FORM         → { username, password }
  //   HEADER       → { headerValue }
  //   COOKIE       → { cookieValue }
  //   OAUTH2       → { clientSecret, username?, password? }
  encryptedCreds   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

model DomainApiSpec {
  id          String   @id @default(cuid())
  domainId    String   @unique
  filename    String                        // original filename, e.g. "openapi.json"
  specJson    Json                          // parsed OpenAPI/Swagger spec
  endpoints   Int      @default(0)          // count of extracted endpoints
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

model SubdomainDiscovery {
  id             String   @id @default(cuid())
  domainId       String
  subdomain      String
  isLive         Boolean  @default(false)
  statusCode     Int?
  technologies   String[]
  includedInScan Boolean  @default(false)
  discoveredAt   DateTime @default(now())

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, subdomain])
  @@index([domainId])
}

// ── Phase 28 Slice A — runtime detection / Wazuh agents ───────────────────
//
// One row per Wazuh agent that's enrolled and reporting to a manager
// configured for this BreachLens org. The ingestion service polls Wazuh
// every 60s, transforms alerts into Finding rows (scanType=RUNTIME), and
// updates lastHeartbeatAt + lastAlertAt here so the UI can show "live"
// agent health without re-querying Wazuh on every page load.
//
// linkedContainerId is operator-declared (Phase 27 Slice A asset graph) and
// lets the correlation engine bridge a runtime alert to existing static
// findings on the same container — the killshot Phase 28 demo.
//
// We deliberately do NOT cascade-delete from Container because Wazuh agents
// outlive container recreations; if a container is removed from BreachLens,
// the agent stays enrolled at the Wazuh manager and the linkage is just
// blanked (set null) — operator can re-link to the new Container row.
model WorkloadAgent {
  id                String       @id @default(cuid())
  orgId             String
  // Wazuh's assigned numeric agent ID (e.g. "001"). Unique per Wazuh manager;
  // we scope by (orgId, wazuhAgentId) so two orgs sharing the same manager
  // see only their own agents (multi-tenant Wazuh — Phase 28.x concern).
  wazuhAgentId      String
  wazuhAgentName    String       // human-readable: hostname or container name
  // Optional Phase 27 graph link — operator declares which Container this
  // agent monitors. Null when the operator hasn't decided yet.
  linkedContainerId String?
  status            AgentStatus  @default(UNKNOWN)
  lastHeartbeatAt   DateTime?
  lastAlertAt       DateTime?
  // Wazuh agent version reported on enrolment. Useful for upgrade tracking
  // when a CVE drops in the agent itself.
  agentVersion      String?
  // Last error message from the ingestion poller (if poll failed). Cleared
  // on the next successful poll so the UI only ever shows live problems.
  lastIngestError   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([orgId, wazuhAgentId])
  @@index([orgId, status])
}

model ScanJob {
  id             String     @id @default(cuid())
  orgId          String
  targetType     TargetType
  repositoryId   String?
  containerId    String?
  domainId       String?
  scanTypes      ScanType[]
  bullJobIds     Json       @default("{}")
  totalScans     Int        @default(0)
  completedScans Int        @default(0)
  // Per-scan-type failure tracking. A sub-scan that errors at the scanner
  // (e.g. ZAP unreachable, Nuclei crash, scanner HTTP 5xx) appends its
  // scanType here. Used by:
  //   - parent ScanJob status:  all-failed → FAILED, partial → COMPLETED + error
  //   - /scans/:id/diff:        excludes failed types so a broken DAST scan
  //                             can't make prior DAST findings look "fixed"
  failedScanTypes ScanType[] @default([])
  status         ScanStatus @default(PENDING)
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?
  // Trigger metadata (PR scans, push scans, scheduled scans). `triggerType`
  // stays MANUAL for the legacy "user clicked Scan" flow so existing rows
  // don't need backfilling.
  triggerType    ScanTrigger @default(MANUAL)
  commitSha      String?     // head SHA actually scanned
  baseCommitSha  String?     // PR base SHA (used for diffing new vs existing findings)
  branch         String?
  prNumber       Int?        // GitHub PR number when triggerType = PULL_REQUEST
  // Non-empty → incremental scan. Scanners use this list to limit Semgrep
  // --include / Trivy / Checkov / TruffleHog targets. Empty/null → full scan.
  changedFiles   String[]    @default([])
  // The set of URLs the scanner actually examined this run (PENTEST_FULL,
  // DAST recordings). Persisted as JSON so the diff endpoint can distinguish
  // "URL was in scope but vuln gone" (genuinely fixed) from "URL was never
  // re-visited" (out of scope). Null on legacy scans + repo/container scans.
  // Stored as Json (not String[]) because the array can be 100s of URLs and
  // a TEXT[] column would index slowly + we never query individual URLs.
  targetUrls     Json?
  // Severity counts
  criticalCount  Int        @default(0)
  highCount      Int        @default(0)
  mediumCount    Int        @default(0)
  lowCount       Int        @default(0)
  infoCount      Int        @default(0)
  // AI-generated scan summary (Phase 2)
  aiSummary      String?    @db.Text
  aiSummarisedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repository Repository?  @relation(fields: [repositoryId], references: [id])
  container  Container?   @relation(fields: [containerId], references: [id])
  domain     Domain?      @relation(fields: [domainId], references: [id])
  findings   Finding[]
  reports    Report[]
  recordings         RecordingSession[] @relation("RecordingInteractiveScan")
  promotedRecordings RecordingSession[] @relation("RecordingPromotedScan")
  prCheckRun         PrCheckRun?

  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@index([repositoryId, prNumber])
}

model Finding {
  id             String        @id @default(cuid())
  orgId          String
  scanJobId      String
  targetType     TargetType
  repositoryId   String?
  containerId    String?
  domainId       String?
  scanType       ScanType
  title          String
  description    String        @db.Text
  severity       Severity
  status         FindingStatus @default(OPEN)
  filePath       String?
  lineStart      Int?
  lineEnd        Int?
  codeSnippet    String?       @db.Text
  cveId          String?
  cweId          String?
  packageName    String?
  packageVersion String?
  fixVersion     String?
  cvssScore      Float?
  scanner        String
  ruleId         String?
  fingerprint    String        @unique
  remediation    String?       @db.Text
  references     String[]
  rawOutput      Json
  firstSeen      DateTime      @default(now())
  lastSeen       DateTime      @default(now())
  resolvedAt     DateTime?
  confidence     Confidence    @default(POSSIBLE)
  evidence       Json?
  verifiedAt     DateTime?
  aiAnalysis     Json?         // cached AI analysis result
  aiAnalysedAt   DateTime?     // when the AI analysis was last generated
  // AI false-positive detection (Phase FP)
  aiFpAnalysis   Json?         // { verdict, confidence, reasoning, indicators }
  aiFpAnalysedAt DateTime?
  // AI fix suggestion — unified diff
  aiFixSuggestion   String?   @db.Text
  aiFixSuggestedAt  DateTime?
  // Snooze — finding is hidden until this timestamp passes (reopens automatically).
  // Set by the /snooze PR command; independent of status, which may still be OPEN.
  snoozedUntil      DateTime?
  // Auto-fix absence counter for flaky scanners (DAST/PENTEST family).
  // Incremented each time a scan of the finding's own scanType completes
  // without re-observing this fingerprint; reset to 0 on re-observation.
  // We only mark status=FIXED once this crosses a threshold (see
  // findingService.upsertFindings) to avoid false closures from a single
  // flaky ZAP / nuclei / nikto run.
  absenceCount      Int       @default(0)

  // Phase 14 — reachability classification. UNKNOWN for findings that
  // pre-date Phase 14; NOT_APPLICABLE for non-SCA findings; REACHABLE /
  // NOT_REACHABLE for SCA findings the scanner classified at scan time.
  // Evidence is a JSON array of file paths where the package was found
  // imported (when REACHABLE) — gold for triage ("show me the 3 files
  // that depend on this vulnerable package").
  reachability         Reachability @default(UNKNOWN)
  reachabilityEvidence Json?

  // Phase 27 Slice B — attack-path correlation. correlationGroupId stamps
  // every Finding in the same chain with a stable id (anchored on the chain's
  // root finding) so chains can be looked up via index. correlationEdges is
  // JSON [{toFindingId, bridgeType, confidence, reason}]. correlationComputedAt
  // lets the recurring sweep prioritise stale rows. All nullable until the
  // engine has run for this finding.
  correlationGroupId    String?
  correlationEdges      Json?
  correlationComputedAt DateTime?

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scanJob    ScanJob      @relation(fields: [scanJobId], references: [id])
  repository Repository?  @relation(fields: [repositoryId], references: [id])
  container  Container?   @relation(fields: [containerId], references: [id])
  domain     Domain?      @relation(fields: [domainId], references: [id])
  ticket     Ticket?
  // Phase 16 compliance mapping — many-to-many to ComplianceControl via the
  // FindingControl join table. Computed on-demand by the mapping service
  // (CWE → control rules) and persisted so dashboards can JOIN cheaply.
  complianceMappings FindingControl[]

  @@index([orgId, severity, status])
  @@index([orgId, scanType])
  @@index([fingerprint])
  @@index([cweId])  // Phase 16 — fast CWE-based mapping lookups
  @@index([orgId, correlationGroupId])  // Phase 27 — chain lookups
}

// ── Compliance framework mapping (Phase 16) ───────────────────────────────
// Auditor-facing layer — maps every Finding to one or more ComplianceControls
// across multiple frameworks (SOC 2, OWASP Top 10, PCI DSS). Frameworks are
// modelled as an enum (closed set, low churn); controls are rows so we can
// add / amend / re-categorise without a schema change.

enum ComplianceFramework {
  SOC2
  OWASP_TOP_10
  PCI_DSS
  // ISO_27001, NIST_CSF, HIPAA can be added without code changes — extend
  // the enum + insert ComplianceControl rows + the dashboards index by
  // framework so they appear automatically.
}

model ComplianceControl {
  id           String              @id @default(cuid())
  framework    ComplianceFramework
  code         String              // SOC2: "CC6.1" · OWASP: "A01:2021" · PCI: "Req-6.5.1"
  name         String              // human-readable
  description  String              @db.Text
  category     String?             // optional grouping (e.g. SOC2 "Common Criteria 6 — Logical Access")
  // CWE IDs that satisfy this control, stored as ints (the CWE number without
  // the "CWE-" prefix). Source mapping documented in the seed script.
  cweIds       Int[]               @default([])
  // Free-form keyword matches for findings without a CWE (DAST output
  // sometimes lacks one). Falls back to title-substring search in the
  // mapping service.
  keywordTags  String[]            @default([])
  // Display order within a framework (lets us list CC6.1, CC6.2, ... in
  // sequence even though codes sort weirdly as strings).
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  findingMappings FindingControl[]

  @@unique([framework, code])
  @@index([framework, sortOrder])
}

// Many-to-many bridge between Finding and ComplianceControl. Populated by
// complianceMappingService (CWE → controls + keyword fallback). Re-computed
// when a Finding is created/updated, or via a manual backfill of existing
// findings after a CWE-mapping rule change.
model FindingControl {
  id              String   @id @default(cuid())
  findingId       String
  controlId       String
  // Why this finding maps to this control — "cwe-match" | "keyword" | "manual"
  // (manual is reserved for future SECURITY-tier override).
  matchReason     String
  createdAt       DateTime @default(now())

  finding         Finding           @relation(fields: [findingId], references: [id], onDelete: Cascade)
  control         ComplianceControl @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@unique([findingId, controlId])
  @@index([controlId])
}

model Ticket {
  id          String       @id @default(cuid())
  orgId       String
  findingId   String       @unique
  title       String
  description String?      @db.Text
  status      TicketStatus @default(OPEN)
  priority    Priority
  jiraKey     String?
  jiraUrl     String?
  slackTs     String?
  teamsId     String?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  finding   Finding      @relation(fields: [findingId], references: [id])
  createdBy User         @relation(fields: [createdById], references: [id])

  @@index([orgId, status])
}

model Report {
  id          String        @id @default(cuid())
  orgId       String
  scanJobId   String?
  targetType  TargetType
  targetId    String
  trigger     ReportTrigger @default(ON_SCAN_COMPLETE)
  title       String
  htmlContent String        @db.Text
  metadata    Json          // { targetName, riskScore, riskGrade, criticalCount, highCount, ... }
  generatedAt DateTime      @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scanJob ScanJob?     @relation(fields: [scanJobId], references: [id], onDelete: SetNull)

  @@index([orgId, generatedAt])
  @@index([orgId, targetType, targetId])
}

// ── Suppressions (exception / accepted-risk workflow) ─────────────────────────
// When a finding's fingerprint matches an active (non-expired) suppression,
// it is hidden from default finding queries. Toggle with ?includeSuppressed=true.
model Suppression {
  id           String    @id @default(cuid())
  orgId        String
  fingerprint  String    // matches Finding.fingerprint; so dedups across re-scans
  reason       String    @db.Text
  expiresAt    DateTime?
  approvedById String
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokedById  String?

  @@index([orgId, fingerprint])
  @@index([orgId, revokedAt])
}

// ── Audit log ─────────────────────────────────────────────────────────────────
// Free-form record of mutation events. Written by services; read via settings UI.
model AuditEvent {
  id           String   @id @default(cuid())
  orgId        String
  userId       String
  action       String   // e.g. "suppression.create", "finding.status_change", "repo.delete"
  resourceType String   // e.g. "Finding", "Repository", "Suppression"
  resourceId   String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, resourceType, resourceId])
}

model Integration {
  id            String          @id @default(cuid())
  orgId         String
  type          IntegrationType
  encryptedData Json
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, type])
}

// ── AI Provider configuration (per org) ──────────────────────────────────────
// Stores the provider's API key (encrypted) + the org's chosen default model
// for that provider. Exactly one row per (org, type). Set isDefault=true on
// the row that should be used when a service has no explicit routing override.
model AIProvider {
  id              String         @id @default(cuid())
  orgId           String
  type            AIProviderType
  // Encrypted via encryptionService (same JSON-with-IV shape as Integration).
  // Decrypted shape: { apiKey: string }  for ANTHROPIC/OPENAI/GEMINI
  //                  { /* nothing required */ } for OLLAMA (uses baseUrl)
  encryptedConfig Json
  // Public model id used when this provider is selected and no override given.
  // e.g. "claude-sonnet-4-5", "gpt-5", "gemini-2.5-pro", "llama3.1:8b"
  defaultModel    String
  // Override the SDK base URL — required for Ollama (e.g. http://ollama:11434),
  // optional for Anthropic/OpenAI (e.g. proxies, Azure OpenAI, Bedrock).
  baseUrl         String?
  isActive        Boolean        @default(true)
  isDefault       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  org      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  routings AIServiceRouting[]

  @@unique([orgId, type])
  @@index([orgId, isDefault])
}

// ── Per-service provider routing override ────────────────────────────────────
// Optional. If a service name has no row here, the org's default AIProvider
// (isDefault=true) is used. Lets ops say "use Anthropic Sonnet for FP triage,
// but route fix-suggestion through local Ollama for compliance."
model AIServiceRouting {
  id            String        @id @default(cuid())
  orgId         String
  service       AIServiceName
  providerId    String
  // Optional model override — falls back to AIProvider.defaultModel if null.
  modelOverride String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider AIProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([orgId, service])
}

// ── Per-call telemetry for cost dashboards & A/B comparisons ─────────────────
// One row per AI invocation. Cheap (Postgres can take it) and gives you ground
// truth instead of estimating from prompt sizes. Token fields use providers'
// reported counts; cached_tokens is provider-specific (Anthropic prompt cache,
// OpenAI cached input). Cost is computed at insert time from a price table so
// historical reporting stays correct when prices change.
model AICallLog {
  id                String        @id @default(cuid())
  orgId             String
  service           AIServiceName
  providerType      AIProviderType
  model             String
  inputTokens       Int           @default(0)
  outputTokens      Int           @default(0)
  cachedInputTokens Int           @default(0)   // 0 if provider doesn't support
  latencyMs         Int
  costUsd           Decimal       @default(0) @db.Decimal(10, 6)
  // For correlating with the resource that triggered it
  findingId         String?
  scanJobId         String?
  errorMessage      String?       // null on success
  createdAt         DateTime      @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, service, createdAt])
  @@index([orgId, providerType, createdAt])
}

// ── Policy engine ────────────────────────────────────────────────────────────
// A Policy is the org's configuration for "what blocks a PR / fails a scan".
// Resolution: repo.policyId → first Policy whose repoIds contains repo.id →
// org's isDefault=true policy → no policy (conclusion = neutral, never fails).
model Policy {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  // Exactly one default per org enforced in application code (no unique
  // partial index in Prisma yet — trade-off for cross-DB portability).
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  // Scope — empty arrays mean "applies to all repos / all branches".
  // repoIds overrides branchPatterns: if a repo is explicitly listed here or
  // references this policy via repository.policyId, branchPatterns are ignored.
  repoIds        String[] @default([])
  branchPatterns String[] @default([])    // glob patterns e.g. ["main", "release/*"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rules        PolicyRule[]
  repositories Repository[]   // repos that reference this policy via policyId

  @@index([orgId, isActive])
  @@index([orgId, isDefault])
}

model PolicyRule {
  id       String         @id @default(cuid())
  policyId String
  type     PolicyRuleType
  // Config shape varies by type (validated by policyService):
  //   SEVERITY_THRESHOLD → { severity: "CRITICAL" | "HIGH" | "MEDIUM" | "LOW" }
  //   BLOCK_ON_NEW_ONLY  → {}
  //   SLA_DAYS           → { severity: Severity, days: number }
  //   IGNORE_DEV_DEPS    → {}
  //   SCAN_TYPE_REQUIRED → { scanTypes: ScanType[] }
  config   Json           @default("{}")
  createdAt DateTime      @default(now())

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
}

// ── GitHub Check Run tracking ────────────────────────────────────────────────
// One row per (ScanJob on a PR). Lets us PATCH the same check_run.id to push
// in_progress / completed updates, and correlate later webhook events (user
// dismissing an annotation, re-requesting the check, etc.) back to our scan.
model PrCheckRun {
  id           String   @id @default(cuid())
  scanJobId    String   @unique
  repositoryId String
  prNumber     Int
  headSha      String
  baseSha      String
  // GitHub check_run.id is a 64-bit int. Prisma maps this to bigint in Postgres.
  checkRunId   BigInt
  // Mirrors the GitHub Check Run fields so we can query our state without an
  // API call. Status: queued | in_progress | completed. Conclusion: success |
  // failure | neutral | cancelled | timed_out | action_required.
  status       String   @default("queued")
  conclusion   String?
  // How many inline review comments we posted (capped to avoid PR spam). Used
  // to decide whether to post a summary comment on subsequent syncs.
  commentsPosted Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scanJob    ScanJob    @relation(fields: [scanJobId],    references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, prNumber])
  @@index([repositoryId, headSha])
}
