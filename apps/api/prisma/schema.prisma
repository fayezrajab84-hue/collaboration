// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────

enum OrgType {
  PERSONAL
  TEAM
}

enum Role {
  OWNER
  ADMIN
  SECURITY
  DEVELOPER
  VIEWER
  MEMBER     // legacy — treated as DEVELOPER by RBAC layer
}

enum ScanType {
  SAST
  SCA
  SECRET
  IAC
  CONTAINER
  DAST
  PENTEST
  PENTEST_FULL
}

enum RecordingStatus {
  ACTIVE      // user is currently browsing through the proxy
  STOPPED     // user clicked stop or session timed out
  SCANNING    // active scan kicked off; recording is implicitly stopped
  COMPLETED   // active scan finished
  FAILED      // active scan errored out
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  OPEN
  ACKNOWLEDGED
  FALSE_POSITIVE
  FIXED
  IGNORED          // AI-auto-dismissed: LIKELY_FP + HIGH confidence in sweep
}

enum Confidence {
  CONFIRMED
  LIKELY
  POSSIBLE
}

enum ScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum TargetType {
  REPOSITORY
  CONTAINER
  DOMAIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IntegrationType {
  JIRA
  SLACK
  MICROSOFT_TEAMS
}

// ── AI provider abstraction ──────────────────────────────────────────────────
// Lets each org plug in any of these as their AI backend, and optionally route
// individual services (FP triage / fix suggestion / scan summary / …) to
// different providers. Keys are AES-256-GCM encrypted via encryptionService,
// same pattern as Integration.encryptedData.
enum AIProviderType {
  ANTHROPIC
  OPENAI
  GEMINI
  OLLAMA
}

// One row per AI service that the platform calls. Used as the discriminator
// for per-service routing overrides. Add new entries here when introducing a
// new AI-backed feature.
enum AIServiceName {
  ANALYSE_FINDING       // aiService.analyseFinding — drawer deep analysis
  FP_TRIAGE             // falsePositiveService — verdict + confidence
  FIX_SUGGESTION        // fixSuggestionService — unified diff
  SCAN_SUMMARY          // scanSummaryService — post-scan paragraph
  RISK_SCORE            // riskScoringService — repo/container/domain score
  CHAT                  // chatService — interactive Q&A
  GROUP_INSIGHT         // findingGroupService — cluster commentary
}

enum ReportTrigger {
  ON_SCAN_COMPLETE
  MANUAL
}

enum PentestDepth {
  STANDARD    // recon + discovery + vuln scan (no exploitation)
  AGGRESSIVE  // + exploitation phase (SQLMap, XSStrike) — requires authorization
}

enum AuthType {
  FORM    // submit username/password form, maintain session cookie
  HEADER  // inject a static HTTP header (API key, Bearer token)
  COOKIE  // inject a pre-obtained cookie string directly
  OAUTH2  // exchange client credentials / ROPC for a Bearer token
}

// ── Scan trigger + PR-check integration ──────────────────────────────────────
// Separates how a scan was initiated from what it scanned. PR scans fan out to
// PrCheckRun which tracks the GitHub Check Run row so we can update it from the
// worker as the scan progresses / completes.
enum ScanTrigger {
  MANUAL          // user clicked "Scan" in the UI or hit POST /scan
  PUSH            // default-branch push webhook
  PULL_REQUEST    // PR open / sync / reopen
  SCHEDULED       // cron
}

// Policy rules: each row is one gate that contributes to the PR check decision.
// `config` is rule-type-specific — validated in code, not in the DB.
enum PolicyRuleType {
  SEVERITY_THRESHOLD    // config: { severity: Severity }       → fail if any OPEN finding ≥ severity
  BLOCK_ON_NEW_ONLY     // config: {}                           → qualifier: scope thresholds to PR-new findings
  SLA_DAYS              // config: { severity, days }           → fail if OPEN finding at severity older than N days
  IGNORE_DEV_DEPS       // config: {}                           → strip SCA findings in devDependencies
  SCAN_TYPE_REQUIRED    // config: { scanTypes: ScanType[] }    → fail if any required type didn't run successfully
}

// ── Models ────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  githubId     String   @unique
  username     String
  email        String?
  avatarUrl    String?
  accessToken  String   // AES-256-GCM encrypted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizations OrganizationMember[]
  tickets       Ticket[]
  recordings    RecordingSession[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  type      OrgType  @default(PERSONAL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         OrganizationMember[]
  repositories    Repository[]
  containers      Container[]
  domains         Domain[]
  integrations    Integration[]
  findings        Finding[]
  tickets         Ticket[]
  scanJobs        ScanJob[]
  reports         Report[]
  aiProviders     AIProvider[]
  aiServiceRoutings AIServiceRouting[]
  aiCallLogs      AICallLog[]
  recordings      RecordingSession[]
  policies        Policy[]
}

model OrganizationMember {
  userId String
  orgId  String
  role   Role     @default(DEVELOPER)

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([userId, orgId])
}

model Repository {
  id            String    @id @default(cuid())
  orgId         String
  githubId      Int       @unique
  fullName      String
  url           String
  defaultBranch String    @default("main")
  isPrivate     Boolean   @default(false)
  language      String?
  webhookId     Int?
  webhookSecret  String?   // AES-256-GCM encrypted
  // Set when the GitHub App is installed on the owner + has this repo in scope.
  // Required for posting PR Check Runs + inline review comments. Nullable so
  // platform keeps working for repos added via the legacy PAT webhook path.
  githubAppInstallationId Int?
  // Optional per-repo policy override. When null, policyService falls back to
  // the org's Policy with isDefault=true.
  policyId                String?
  lastScannedAt  DateTime?
  aiRiskScore    Int?      // 0-100
  aiRiskReason   String?
  aiRiskScoredAt DateTime?
  addedAt        DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  policy      Policy?      @relation(fields: [policyId], references: [id], onDelete: SetNull)
  scans       ScanJob[]
  findings    Finding[]
  prCheckRuns PrCheckRun[]

  @@index([orgId, githubAppInstallationId])
}

model Container {
  id             String    @id @default(cuid())
  orgId          String
  imageRef       String
  registry       String?
  lastScannedAt  DateTime?
  aiRiskScore    Int?
  aiRiskReason   String?
  aiRiskScoredAt DateTime?
  addedAt        DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scans    ScanJob[]
  findings Finding[]
}

model Domain {
  id              String       @id @default(cuid())
  orgId           String
  domain          String
  lastScannedAt   DateTime?
  aiRiskScore     Int?
  aiRiskReason    String?
  aiRiskScoredAt  DateTime?
  addedAt         DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  // Pentest authorization
  authorized      Boolean      @default(false)
  authorizedAt    DateTime?
  authorizedById  String?
  pentestDepth    PentestDepth @default(STANDARD)
  excludePaths    String[]

  org         Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scans       ScanJob[]
  findings    Finding[]
  subdomains  SubdomainDiscovery[]
  authConfig  DomainAuthConfig?
  apiSpec     DomainApiSpec?
  recordings  RecordingSession[]
}

// ── Interactive DAST recording session ────────────────────────────────────────
// One row per "user opens browser → proxies through ZAP → scans recorded URLs"
// flow. ACTIVE rows hold a ZAP context open; the single-session lock is enforced
// by the unique partial index below (only one ACTIVE row per org at a time).
model RecordingSession {
  id              String          @id @default(cuid())
  orgId           String
  domainId        String
  startedById     String                                  // user who clicked "Start Recording"
  zapContextId    String                                  // ZAP-assigned numeric context id
  zapContextName  String                                  // human-readable name we picked
  status          RecordingStatus @default(ACTIVE)
  urlCount        Int             @default(0)             // last polled count of recorded URLs
  alertCount      Int             @default(0)             // last polled passive-scan alert count
  lastActivityAt  DateTime        @default(now())         // bumped each time we see new URLs (for idle auto-stop)
  scanJobId       String?                                 // populated when user kicks off the active scan (interactive DAST)
  promotedScanJobId String?                               // populated when user "Promotes to Full Pentest" (PENTEST_FULL, independent of scanJobId)
  startedAt       DateTime        @default(now())
  endedAt         DateTime?
  errorMessage    String?

  domain          Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  startedBy       User     @relation(fields: [startedById], references: [id])
  scanJob         ScanJob? @relation("RecordingInteractiveScan", fields: [scanJobId],         references: [id])
  promotedScanJob ScanJob? @relation("RecordingPromotedScan",    fields: [promotedScanJobId], references: [id])

  @@index([orgId, status])
  @@index([domainId, startedAt])
}

// ── Scan authentication config ────────────────────────────────────────────────
// Stores encrypted credentials used by ZAP and Nuclei for authenticated scans.
model DomainAuthConfig {
  id               String   @id @default(cuid())
  domainId         String   @unique
  authType         AuthType @default(FORM)
  // FORM auth fields
  loginUrl         String?                   // absolute or path: /login.php
  usernameField    String   @default("username")
  passwordField    String   @default("password")
  loggedInPattern  String   @default("Logout")   // regex ZAP checks to confirm auth
  loggedOutPattern String   @default("login")    // redirect URL fragment = session expired
  // HEADER / COOKIE auth fields
  headerName       String?                   // e.g. "Authorization", "Cookie"
  // OAuth2 fields (authType = OAUTH2)
  oauth2TokenUrl   String?                   // e.g. https://auth.example.com/oauth/token
  oauth2ClientId   String?
  oauth2Scope      String?                   // space-separated, e.g. "openid profile api:read"
  oauth2GrantType  String   @default("client_credentials")  // client_credentials | password
  // Encrypted payload — AES-256-GCM JSON blob:
  //   FORM         → { username, password }
  //   HEADER       → { headerValue }
  //   COOKIE       → { cookieValue }
  //   OAUTH2       → { clientSecret, username?, password? }
  encryptedCreds   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

model DomainApiSpec {
  id          String   @id @default(cuid())
  domainId    String   @unique
  filename    String                        // original filename, e.g. "openapi.json"
  specJson    Json                          // parsed OpenAPI/Swagger spec
  endpoints   Int      @default(0)          // count of extracted endpoints
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
}

model SubdomainDiscovery {
  id             String   @id @default(cuid())
  domainId       String
  subdomain      String
  isLive         Boolean  @default(false)
  statusCode     Int?
  technologies   String[]
  includedInScan Boolean  @default(false)
  discoveredAt   DateTime @default(now())

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, subdomain])
  @@index([domainId])
}

model ScanJob {
  id             String     @id @default(cuid())
  orgId          String
  targetType     TargetType
  repositoryId   String?
  containerId    String?
  domainId       String?
  scanTypes      ScanType[]
  bullJobIds     Json       @default("{}")
  totalScans     Int        @default(0)
  completedScans Int        @default(0)
  status         ScanStatus @default(PENDING)
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?
  // Trigger metadata (PR scans, push scans, scheduled scans). `triggerType`
  // stays MANUAL for the legacy "user clicked Scan" flow so existing rows
  // don't need backfilling.
  triggerType    ScanTrigger @default(MANUAL)
  commitSha      String?     // head SHA actually scanned
  baseCommitSha  String?     // PR base SHA (used for diffing new vs existing findings)
  branch         String?
  prNumber       Int?        // GitHub PR number when triggerType = PULL_REQUEST
  // Non-empty → incremental scan. Scanners use this list to limit Semgrep
  // --include / Trivy / Checkov / TruffleHog targets. Empty/null → full scan.
  changedFiles   String[]    @default([])
  // Severity counts
  criticalCount  Int        @default(0)
  highCount      Int        @default(0)
  mediumCount    Int        @default(0)
  lowCount       Int        @default(0)
  infoCount      Int        @default(0)
  // AI-generated scan summary (Phase 2)
  aiSummary      String?    @db.Text
  aiSummarisedAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repository Repository?  @relation(fields: [repositoryId], references: [id])
  container  Container?   @relation(fields: [containerId], references: [id])
  domain     Domain?      @relation(fields: [domainId], references: [id])
  findings   Finding[]
  reports    Report[]
  recordings         RecordingSession[] @relation("RecordingInteractiveScan")
  promotedRecordings RecordingSession[] @relation("RecordingPromotedScan")
  prCheckRun         PrCheckRun?

  @@index([orgId, status])
  @@index([orgId, createdAt])
  @@index([repositoryId, prNumber])
}

model Finding {
  id             String        @id @default(cuid())
  orgId          String
  scanJobId      String
  targetType     TargetType
  repositoryId   String?
  containerId    String?
  domainId       String?
  scanType       ScanType
  title          String
  description    String        @db.Text
  severity       Severity
  status         FindingStatus @default(OPEN)
  filePath       String?
  lineStart      Int?
  lineEnd        Int?
  codeSnippet    String?       @db.Text
  cveId          String?
  cweId          String?
  packageName    String?
  packageVersion String?
  fixVersion     String?
  cvssScore      Float?
  scanner        String
  ruleId         String?
  fingerprint    String        @unique
  remediation    String?       @db.Text
  references     String[]
  rawOutput      Json
  firstSeen      DateTime      @default(now())
  lastSeen       DateTime      @default(now())
  resolvedAt     DateTime?
  confidence     Confidence    @default(POSSIBLE)
  evidence       Json?
  verifiedAt     DateTime?
  aiAnalysis     Json?         // cached AI analysis result
  aiAnalysedAt   DateTime?     // when the AI analysis was last generated
  // AI false-positive detection (Phase FP)
  aiFpAnalysis   Json?         // { verdict, confidence, reasoning, indicators }
  aiFpAnalysedAt DateTime?
  // AI fix suggestion — unified diff
  aiFixSuggestion   String?   @db.Text
  aiFixSuggestedAt  DateTime?
  // Snooze — finding is hidden until this timestamp passes (reopens automatically).
  // Set by the /snooze PR command; independent of status, which may still be OPEN.
  snoozedUntil      DateTime?
  // Auto-fix absence counter for flaky scanners (DAST/PENTEST family).
  // Incremented each time a scan of the finding's own scanType completes
  // without re-observing this fingerprint; reset to 0 on re-observation.
  // We only mark status=FIXED once this crosses a threshold (see
  // findingService.upsertFindings) to avoid false closures from a single
  // flaky ZAP / nuclei / nikto run.
  absenceCount      Int       @default(0)

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scanJob    ScanJob      @relation(fields: [scanJobId], references: [id])
  repository Repository?  @relation(fields: [repositoryId], references: [id])
  container  Container?   @relation(fields: [containerId], references: [id])
  domain     Domain?      @relation(fields: [domainId], references: [id])
  ticket     Ticket?

  @@index([orgId, severity, status])
  @@index([orgId, scanType])
  @@index([fingerprint])
}

model Ticket {
  id          String       @id @default(cuid())
  orgId       String
  findingId   String       @unique
  title       String
  description String?      @db.Text
  status      TicketStatus @default(OPEN)
  priority    Priority
  jiraKey     String?
  jiraUrl     String?
  slackTs     String?
  teamsId     String?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  finding   Finding      @relation(fields: [findingId], references: [id])
  createdBy User         @relation(fields: [createdById], references: [id])

  @@index([orgId, status])
}

model Report {
  id          String        @id @default(cuid())
  orgId       String
  scanJobId   String?
  targetType  TargetType
  targetId    String
  trigger     ReportTrigger @default(ON_SCAN_COMPLETE)
  title       String
  htmlContent String        @db.Text
  metadata    Json          // { targetName, riskScore, riskGrade, criticalCount, highCount, ... }
  generatedAt DateTime      @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scanJob ScanJob?     @relation(fields: [scanJobId], references: [id], onDelete: SetNull)

  @@index([orgId, generatedAt])
  @@index([orgId, targetType, targetId])
}

// ── Suppressions (exception / accepted-risk workflow) ─────────────────────────
// When a finding's fingerprint matches an active (non-expired) suppression,
// it is hidden from default finding queries. Toggle with ?includeSuppressed=true.
model Suppression {
  id           String    @id @default(cuid())
  orgId        String
  fingerprint  String    // matches Finding.fingerprint; so dedups across re-scans
  reason       String    @db.Text
  expiresAt    DateTime?
  approvedById String
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokedById  String?

  @@index([orgId, fingerprint])
  @@index([orgId, revokedAt])
}

// ── Audit log ─────────────────────────────────────────────────────────────────
// Free-form record of mutation events. Written by services; read via settings UI.
model AuditEvent {
  id           String   @id @default(cuid())
  orgId        String
  userId       String
  action       String   // e.g. "suppression.create", "finding.status_change", "repo.delete"
  resourceType String   // e.g. "Finding", "Repository", "Suppression"
  resourceId   String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, resourceType, resourceId])
}

model Integration {
  id            String          @id @default(cuid())
  orgId         String
  type          IntegrationType
  encryptedData Json
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, type])
}

// ── AI Provider configuration (per org) ──────────────────────────────────────
// Stores the provider's API key (encrypted) + the org's chosen default model
// for that provider. Exactly one row per (org, type). Set isDefault=true on
// the row that should be used when a service has no explicit routing override.
model AIProvider {
  id              String         @id @default(cuid())
  orgId           String
  type            AIProviderType
  // Encrypted via encryptionService (same JSON-with-IV shape as Integration).
  // Decrypted shape: { apiKey: string }  for ANTHROPIC/OPENAI/GEMINI
  //                  { /* nothing required */ } for OLLAMA (uses baseUrl)
  encryptedConfig Json
  // Public model id used when this provider is selected and no override given.
  // e.g. "claude-sonnet-4-5", "gpt-5", "gemini-2.5-pro", "llama3.1:8b"
  defaultModel    String
  // Override the SDK base URL — required for Ollama (e.g. http://ollama:11434),
  // optional for Anthropic/OpenAI (e.g. proxies, Azure OpenAI, Bedrock).
  baseUrl         String?
  isActive        Boolean        @default(true)
  isDefault       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  org      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  routings AIServiceRouting[]

  @@unique([orgId, type])
  @@index([orgId, isDefault])
}

// ── Per-service provider routing override ────────────────────────────────────
// Optional. If a service name has no row here, the org's default AIProvider
// (isDefault=true) is used. Lets ops say "use Anthropic Sonnet for FP triage,
// but route fix-suggestion through local Ollama for compliance."
model AIServiceRouting {
  id            String        @id @default(cuid())
  orgId         String
  service       AIServiceName
  providerId    String
  // Optional model override — falls back to AIProvider.defaultModel if null.
  modelOverride String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider AIProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([orgId, service])
}

// ── Per-call telemetry for cost dashboards & A/B comparisons ─────────────────
// One row per AI invocation. Cheap (Postgres can take it) and gives you ground
// truth instead of estimating from prompt sizes. Token fields use providers'
// reported counts; cached_tokens is provider-specific (Anthropic prompt cache,
// OpenAI cached input). Cost is computed at insert time from a price table so
// historical reporting stays correct when prices change.
model AICallLog {
  id                String        @id @default(cuid())
  orgId             String
  service           AIServiceName
  providerType      AIProviderType
  model             String
  inputTokens       Int           @default(0)
  outputTokens      Int           @default(0)
  cachedInputTokens Int           @default(0)   // 0 if provider doesn't support
  latencyMs         Int
  costUsd           Decimal       @default(0) @db.Decimal(10, 6)
  // For correlating with the resource that triggered it
  findingId         String?
  scanJobId         String?
  errorMessage      String?       // null on success
  createdAt         DateTime      @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, service, createdAt])
  @@index([orgId, providerType, createdAt])
}

// ── Policy engine ────────────────────────────────────────────────────────────
// A Policy is the org's configuration for "what blocks a PR / fails a scan".
// Resolution: repo.policyId → first Policy whose repoIds contains repo.id →
// org's isDefault=true policy → no policy (conclusion = neutral, never fails).
model Policy {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  // Exactly one default per org enforced in application code (no unique
  // partial index in Prisma yet — trade-off for cross-DB portability).
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  // Scope — empty arrays mean "applies to all repos / all branches".
  // repoIds overrides branchPatterns: if a repo is explicitly listed here or
  // references this policy via repository.policyId, branchPatterns are ignored.
  repoIds        String[] @default([])
  branchPatterns String[] @default([])    // glob patterns e.g. ["main", "release/*"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rules        PolicyRule[]
  repositories Repository[]   // repos that reference this policy via policyId

  @@index([orgId, isActive])
  @@index([orgId, isDefault])
}

model PolicyRule {
  id       String         @id @default(cuid())
  policyId String
  type     PolicyRuleType
  // Config shape varies by type (validated by policyService):
  //   SEVERITY_THRESHOLD → { severity: "CRITICAL" | "HIGH" | "MEDIUM" | "LOW" }
  //   BLOCK_ON_NEW_ONLY  → {}
  //   SLA_DAYS           → { severity: Severity, days: number }
  //   IGNORE_DEV_DEPS    → {}
  //   SCAN_TYPE_REQUIRED → { scanTypes: ScanType[] }
  config   Json           @default("{}")
  createdAt DateTime      @default(now())

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
}

// ── GitHub Check Run tracking ────────────────────────────────────────────────
// One row per (ScanJob on a PR). Lets us PATCH the same check_run.id to push
// in_progress / completed updates, and correlate later webhook events (user
// dismissing an annotation, re-requesting the check, etc.) back to our scan.
model PrCheckRun {
  id           String   @id @default(cuid())
  scanJobId    String   @unique
  repositoryId String
  prNumber     Int
  headSha      String
  baseSha      String
  // GitHub check_run.id is a 64-bit int. Prisma maps this to bigint in Postgres.
  checkRunId   BigInt
  // Mirrors the GitHub Check Run fields so we can query our state without an
  // API call. Status: queued | in_progress | completed. Conclusion: success |
  // failure | neutral | cancelled | timed_out | action_required.
  status       String   @default("queued")
  conclusion   String?
  // How many inline review comments we posted (capped to avoid PR spam). Used
  // to decide whether to post a summary comment on subsequent syncs.
  commentsPosted Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scanJob    ScanJob    @relation(fields: [scanJobId],    references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, prNumber])
  @@index([repositoryId, headSha])
}
